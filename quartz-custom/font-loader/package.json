{
  "name": "font-loader",
  "version": "1.0.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup"
  },
  "peerDependencies": {
    "preact": "^10.0.0"
  },
  "devDependencies": {
    "@quartz-community/types": "github:quartz-community/types",
    "preact": "^10.28.2",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3"
  },
  "quartz": {
    "name": "font-loader",
    "displayName": "Font Loader",
    "description": "Injects external font stylesheets into the page head using the print-media preload technique.",
    "version": "1.0.0",
    "quartzVersion": ">=5.0.0",
    "category": "transformer",
    "defaultOrder": 6,
    "defaultEnabled": true
  }
}
