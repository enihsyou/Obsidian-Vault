{
  "name": "content-meta",
  "version": "1.0.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup"
  },
  "peerDependencies": {
    "preact": "^10.0.0"
  },
  "dependencies": {
    "@quartz-community/types": "github:quartz-community/types",
    "@quartz-community/utils": "github:quartz-community/utils",
    "reading-time": "^1.5.0"
  },
  "devDependencies": {
    "preact": "^10.28.2",
    "sass": "^1.97.3",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3"
  },
  "quartz": {
    "name": "content-meta",
    "displayName": "Content Meta",
    "description": "Displays file metadata including creation/modification dates, reading time, and source links.",
    "version": "1.0.0",
    "quartzVersion": ">=5.0.0",
    "category": "component",
    "defaultEnabled": true,
    "defaultOptions": {
      "showReadingTime": true,
      "showComma": true
    },
    "components": {
      "ContentMeta": {
        "displayName": "Content Meta",
        "defaultPosition": "beforeBody",
        "defaultPriority": 20
      }
    }
  }
}
